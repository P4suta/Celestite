{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-notes",
  "description": "Local note editing and its native window and file dialogs.",
  "windows": ["note-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
